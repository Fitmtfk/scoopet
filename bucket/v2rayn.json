{
    "version": "7.24.4",
    "description": "A V2Ray client for Windows, support Xray & v2fly core",
    "homepage": "https://github.com/2dust/v2rayN",
    "license": "GPL-3.0-only",
    "suggest": {
        ".NET Desktop Runtime": "extras/windowsdesktop-runtime-lts",
        "v2fly-core": "v2ray"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/2dust/v2rayN/releases/download/7.24.4/v2rayN-windows-64.zip",
            "hash": "20fc30526fe5a0164ae7b9a1f8b807bf724e87759ad0fb642bd008276a4239e7",
            "extract_dir": "v2rayN-windows-64"
        },
        "arm64": {
            "url": "https://github.com/2dust/v2rayN/releases/download/7.24.4/v2rayN-windows-arm64.zip",
            "hash": "075cf40437ca9617496201ae35ea8ff4e5835c07b0f29dae7aa01415064f35a0",
            "extract_dir": "v2rayN-windows-arm64"
        }
    },
    "pre_install": [
        "Copy-Item -Path \"$dir\\bin\" -Destination \"$persist_dir\" -Recurse -Force",
        "Remove-Item -Path \"$dir\\bin\" -Recurse -Force"
    ],
    "post_install": [
        "$utilsPath = Join-Path $scriptDir '..\\script\\utils.ps1'",
        "if (Test-Path $utilsPath) { . $utilsPath }",
        "Write-Host ''",
        "Update-ScoopTrayIconPath -AppName 'v2rayN' -NewVersion $version -RestartExplorer"
    ],
    "bin": "v2rayN.exe",
    "shortcuts": [
        [
            "v2rayN.exe",
            "v2rayN"
        ]
    ],
    "persist": [
        "guiConfigs",
        "bin"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/2dust/v2rayN/releases/download/$version/v2rayN-windows-64.zip",
                "hash": {
                    "mode": "github"
                }
            },
            "arm64": {
                "url": "https://github.com/2dust/v2rayN/releases/download/$version/v2rayN-windows-arm64.zip",
                "hash": {
                    "mode": "github"
                }
            }
        }
    }
}
